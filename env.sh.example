# Copy to env.sh and fill in. env.sh is git-ignored: never commit it.
export PROJECT_ID="your-project-id"
export REGION="us-central1"
export ZONE="us-central1-a"
export BUCKET="gs://your-unique-bucket-name"      # must be globally unique
# MongoDB Atlas (Stage 5): copy the connection string from Atlas -> Connect -> Drivers.
# It contains your database password: it lives only here, never in the repo or on screen.
export MONGO_URI="mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority"
export MONGO_DB="flights"
