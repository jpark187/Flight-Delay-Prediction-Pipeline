flowchart LR
    subgraph SRC["Sources (all public, free to use)"]
        BTS["BTS On-Time Performance<br/>Oct 1987 – Dec 2025<br/>459 monthly files · ~200M+ flights"]
        NOAA["NOAA GHCNh hourly weather<br/>station-year Parquet"]
        OA["OurAirports<br/>airport coordinates"]
        FAA["FAA NAS airport status<br/>live XML feed (streaming)"]
    end

    subgraph ING["1 · Ingest"]
        LB["load_bts.sh"]
        MAP["build_station_map.py"]
        LW["load_weather.sh"]
        POLL["faa_poller<br/>e2-micro, 1 snapshot/min"]
    end

    subgraph GCS["Google Cloud Storage · data lake"]
        RAW["raw/ flights CSV<br/>weather/raw/ Parquet"]
        LAND["stream/faa/ snapshots"]
        PQ["curated Parquet<br/>flights partitioned Year/Month<br/>weather hourly by station"]
        MODEL["features/ · model/"]
    end

    subgraph SPARK["Spark on Dataproc · create → run → delete"]
        S1["Clean + convert<br/>schema drift by era"]
        S2["Weather QC + units<br/>join flight × weather<br/>(hour before departure)"]
        S3["Windows: rolling route &amp;<br/>airport delay rates"]
        S4["Train MLlib classifier<br/>evaluate on held-out years"]
        SS["Structured Streaming<br/>FAA status → events"]
    end

    DUCK["DuckDB<br/>EDA on Parquet<br/>+ 'ask it twice' check"]

    MONGO[("MongoDB Atlas (M0)<br/>routes · airports · airport_status")]

    subgraph SERVE["Serve &amp; show"]
        API["Cloud Run<br/>prediction API"]
        DASH["Streamlit dashboard<br/>findings"]
        MCP["Claude + MongoDB MCP server<br/>plain-English questions"]
    end

    USER["Travelers · corporate travel desks"]

    BTS --> LB --> RAW
    OA --> MAP --> LW
    NOAA --> LW --> RAW
    FAA --> POLL --> LAND --> SS --> MONGO
    RAW --> S1 --> PQ
    RAW --> S2
    PQ --> S2 --> S3 --> S4 --> MODEL
    S3 --> MONGO
    PQ --> DUCK
    MONGO -. same number two ways .- DUCK
    API -->|reads| MONGO
    API -->|loads| MODEL
    DASH --> MONGO
    MCP --> MONGO
    USER --> API
    USER --> DASH
    USER --> MCP
